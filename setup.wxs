<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MyPLaMo" Manufacturer="MyPLaMo" Version="1.4.0" Codepage="932" Language="1041" UpgradeCode="4BAD4A08-D98B-4256-9D1F-C9280D67D45B" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="新しいバージョンがインストールされています。" />
    <!-- This is the EXE component GUID used by the released 1.1.1 MSI.
         With no FileSearch child, Windows Installer returns its parent folder.
         Keep it stable so upgrades also find custom installation locations. -->
    <Property Id="INSTALLDIR" Secure="yes">
      <ComponentSearch Id="ExistingInstallDirectory" Guid="1441DE5D-259C-53C7-88E5-B06933F7E674" Type="file" />
    </Property>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="build/license-mit.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="MyPLaMoを起動する" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchMyPLaMo" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]MyPLaMo.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchMyPLaMo"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" Order="1" />
    </UI>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs"><Directory Id="INSTALLDIR" Name="MyPLaMo"/></Directory>
    </StandardDirectory>
    <StandardDirectory Id="StartupFolder"/>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartLink" Guid="D86F0E1F-D15A-44D2-82E1-216DF2178040">
        <Shortcut Id="MenuLink" Name="MyPLaMo" Target="[INSTALLDIR]MyPLaMo.exe" WorkingDirectory="INSTALLDIR"/>
        <RegistryValue Root="HKCU" Key="Software\MyPLaMo\Setup" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
        <RemoveFile Id="StartupLink" Directory="StartupFolder" Name="MyPLaMo.lnk" On="uninstall"/>
      </Component>
    </StandardDirectory>
    <Feature Id="App" Title="MyPLaMo">
      <Files Directory="INSTALLDIR" Include="release\MyPLaMo\**"/>
      <ComponentRef Id="StartLink"/>
    </Feature>
  </Package>
</Wix>


